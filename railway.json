{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/src/**",
      "/public/**",
      "/package.json",
      "/package-lock.json",
      "/vite.config.ts",
      "/tsconfig.json",
      "/tsr.config.json",
      "/components.json",
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json",
      "/worker/src/zone-starts.ts"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
